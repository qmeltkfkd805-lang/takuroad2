[
  {"slug":"sumikkogurashi","description":"구석이 편한 개성 넘치는 친구들이 서로의 사연을 품고 조용하고 따뜻한 일상을 보낸다.","genres":["일상","코미디","판타지"],"ipType":["캐릭터","애니","영화"],"officialUrl":"https://www.san-x.co.jp/ja/characters/sumikkogurashi/","source":"https://www.san-x.co.jp/ja/characters/sumikkogurashi/"},
  {"slug":"stardew-valley","description":"할아버지의 낡은 농장을 물려받아 경작하고 이웃과 교류하며 계곡에 활기를 되찾는 생활 RPG.","genres":["일상","판타지","모험","로맨스"],"ipType":["게임"],"officialUrl":"https://www.stardewvalley.net/","source":"https://www.stardewvalley.net/about/"},
  {"slug":"star-wars","description":"광대한 은하에서 제다이와 시스, 공화국과 제국이 포스를 둘러싸고 펼치는 세대의 대서사시.","genres":["액션","SF","판타지","모험"],"ipType":["영화","애니","소설","만화","게임"],"officialUrl":"https://www.starwars.com/","source":"https://www.starwars.com/databank/"},
  {"slug":"studio-ghibli","description":"독창적인 세계와 인물을 손으로 그린 장편 애니메이션으로 빚어 온 일본의 애니메이션 제작사.","genres":["판타지","모험","드라마"],"ipType":["제작사"],"officialUrl":"https://www.ghibli.jp/","source":"https://www.ghibli.jp/profile/"},
  {"slug":"street-fighter","description":"세계 각지의 격투가들이 저마다의 신념과 강함의 답을 품고 필살기를 겨루는 대전 격투 시리즈.","genres":["격투","액션"],"ipType":["게임","애니","영화"],"officialUrl":"https://www.streetfighter.com/","source":"https://www.capcom.co.jp/ir/english/feature/2017_sf30th.html"},
  {"slug":"spider-man","description":"방사능 거미에 물린 피터 파커가 거미 능력과 책임감을 품고 사람들을 지키는 슈퍼히어로 이야기.","genres":["액션","SF","모험","드라마"],"ipType":["만화","캐릭터","애니","영화","게임"],"officialUrl":"https://www.marvel.com/characters/spider-man-peter-parker/","source":"https://www.marvel.com/characters/spider-man-peter-parker/in-comics/profile"},
  {"slug":"spongebob","description":"비키니 시티의 파인애플 집에 사는 스폰지밥이 친구들과 엉뚱하고 유쾌한 소동을 벌인다.","genres":["코미디","일상","모험"],"ipType":["애니","캐릭터","영화","게임"],"officialUrl":"https://www.nick.com/shows/spongebob-squarepants/","source":"https://www.paramountpressexpress.com/nickelodeon/shows/spongebob-squarepants/about/"},
  {"slug":"splatoon","description":"인간이 사라진 세계에서 잉클링과 옥토링이 잉크를 칠하고 헤엄치며 영역을 겨루는 슈팅 게임.","genres":["액션","SF"],"ipType":["게임"],"officialUrl":"https://www.nintendo.com/jp/character/splatoon/","source":"https://www.nintendo.com/jp/character/splatoon/story/index.html"},
  {"slug":"slam-dunk","description":"불량학생 강백호가 농구부에 들어가 동료들과 부딪치며 진짜 농구선수로 성장한다.","genres":["스포츠","학원","코미디","드라마"],"ipType":["만화","애니","영화"],"officialUrl":"https://slamdunk-movie.jp/","source":"https://www.shueisha.co.jp/books/items/contents.html?isbn=4-08-871611-6"},
  {"slug":"slow-loop","description":"아버지에게 배운 플라이 낚시를 즐기는 히요리가 새 가족과 만나 관계를 천천히 이어 간다.","genres":["일상","스포츠","드라마"],"ipType":["만화","애니"],"officialUrl":"https://slowlooptv.com/","source":"https://slowlooptv.com/story/story01.html"},
  {"slug":"goddess-of-victory-nikke","description":"랩쳐에게 지상을 빼앗긴 인류가 지휘관과 전투 안드로이드 니케를 보내 탈환을 꿈꾼다.","genres":["액션","SF","드라마"],"ipType":["게임"],"officialUrl":"https://nikke-en.com/","source":"https://www.youtube.com/watch?v=yw9U2V1ZAJM"},
  {"slug":"cinnamoroll","description":"구름 위에서 태어난 하얀 강아지 시나몬이 큰 귀로 날아 카페 친구들과 포근한 일상을 보낸다.","genres":["일상","판타지"],"ipType":["캐릭터","애니"],"officialUrl":"https://www.sanrio.co.jp/characters/cinnamon/","source":"https://www.sanrio.co.jp/characters/cinnamon/"}
