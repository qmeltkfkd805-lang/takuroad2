[
  {"slug":"legend-of-zelda","description":"용사 링크와 젤다 공주가 시대를 넘어 하이랄을 위협하는 악에 맞서 트라이포스의 운명을 지킨다.","genres":["판타지","모험","액션","퍼즐"],"ipType":["게임","만화"],"officialUrl":"https://www.nintendo.com/jp/character/zelda/","source":"https://www.nintendo.com/jp/character/zelda/en/history/index.html"},
