[
  {"slug":"honzuki-no-gekokujou","description":"책이 귀한 이세계의 병약한 소녀 마인으로 환생한 책벌레가 직접 책을 만들기 위해 신분의 벽에 도전한다.","genres":["판타지","일상","드라마"],"ipType":["웹소설","소설","만화","애니"],"officialUrl":"https://www.tobooks.jp/booklove/","source":"https://ajiado.co.jp/works/archive/O5r-ZJEa"},
  {"slug":"Tengen-Toppa-Gurren-Lagann","description":"지하 마을의 소년 시몬이 카미나와 요코를 만나 지상으로 나아가 인류의 미래를 건 거대한 싸움에 도전한다.","genres":["액션","SF","모험","로봇/메카","드라마"],"ipType":["애니","영화","만화","게임"],"officialUrl":"https://www.gurren-lagann.net/","source":"https://gurren-lagann15th.com/"},
  {"slug":"chainsaw-man","description":"빚을 갚으며 악마를 사냥하던 덴지가 포치타와 계약해 악마의 심장을 지닌 체인소맨으로 되살아난다.","genres":["액션","판타지","호러","고어","소년물"],"ipType":["만화","애니","영화"],"officialUrl":"https://www.chainsawman.dog/","source":"https://www.chainsawman.dog/tvseries/introduction/"},
  {"slug":"oshi-no-ko","description":"전생의 기억과 아이돌 아이의 숨겨진 자녀라는 비밀을 지닌 쌍둥이가 연예계의 빛과 거짓 속으로 들어간다.","genres":["드라마","아이돌","추리","로맨스"],"ipType":["만화","애니","영화","게임"],"officialUrl":"https://ichigoproduction.com/","source":"https://ichigoproduction.com/Season1/story/"},
  {"slug":"tsukiuta","description":"열두 달을 상징하는 캐릭터들이 두 아이돌 유닛으로 활동하며 노래와 음성극으로 계절의 이야기를 전한다.","genres":["음악","아이돌","일상"],"ipType":["캐릭터","애니","게임"],"officialUrl":"https://tsukino-pro.com/tsukiuta/","source":"https://tsukiani.com/1st/about-tsukiuta/"},
  {"slug":"chiikawa","description":"작고 귀여운 치이카와와 하치와레, 우사기가 신비한 세계에서 일하고 먹고 놀며 소소한 하루를 살아간다.","genres":["일상","코미디","판타지"],"ipType":["웹툰","만화","애니","영화","캐릭터","게임"],"officialUrl":"https://chiikawa-info.jp/","source":"https://chiikawa-info.jp/"},
  {"slug":"kaguya-sama","description":"서로 좋아하지만 먼저 고백하면 진다고 믿는 학생회장 미유키와 부회장 카구야가 사랑의 두뇌전을 벌인다.","genres":["로맨스","코미디","학원","일상"],"ipType":["만화","애니","영화"],"officialUrl":"https://kaguya.love/","source":"https://kaguya.love/1st/character/"},
  {"slug":"cardcaptor-sakura","description":"초등학생 사쿠라가 세상에 풀려난 크로우 카드를 회수하기 위해 카드캡터가 되어 마법의 사건에 맞선다.","genres":["마법소녀","판타지","모험","로맨스"],"ipType":["만화","애니","영화","게임"],"officialUrl":"https://ccsakura-official.com/","source":"https://ccsakura-official.com/intro/index2.html"},
  {"slug":"cardfight-vanguard","description":"파이터들이 행성 클레이의 유닛이 담긴 카드를 지휘하며 전략과 상상력으로 일대일 승부를 펼친다.","genres":["판타지","액션","소년물"],"ipType":["카드게임","만화","애니","게임"],"officialUrl":"https://cf-vanguard.com/","source":"https://cf-vanguard.com/about/"},
  {"slug":"kakao-friends","description":"카카오톡 이용자의 감정을 대신 표현하던 라이언과 어피치 등 친구들이 다양한 이야기와 일상의 즐거움을 전한다.","genres":["일상","코미디"],"ipType":["캐릭터","게임"],"officialUrl":"https://www.kakaocorp.com/page/service/service/Kakao%20Friends","source":"https://www.kakaocorp.com/page/service/service/Kakao%20Friends"},
  {"slug":"keroppi","description":"모험을 좋아하는 개구리 케로피가 도넛 연못의 가족과 친구들 사이에서 씩씩하고 즐거운 하루를 보낸다.","genres":["일상","가족","모험"],"ipType":["캐릭터"],"officialUrl":"https://www.sanrio.co.jp/characters/keroppi/","source":"https://www.sanrio.co.jp/characters/keroppi/"},
  {"slug":"k-on","description":"악기 초보 유이가 폐부 직전의 경음악부에 들어가 친구들과 차를 마시고 연주하며 밴드의 추억을 쌓는다.","genres":["음악","학원","일상","코미디"],"ipType":["만화","애니","영화"],"officialUrl":"https://www.kyotoanimation.co.jp/works/k-on/","source":"https://www.kyotoanimation.co.jp/en/works/k-on/"}
