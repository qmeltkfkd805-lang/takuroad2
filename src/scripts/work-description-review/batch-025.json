[
  {"slug":"fairy-tail","description":"불을 먹는 마도사 나츠와 루시가 마도사 길드 페어리 테일의 동료들과 의뢰와 모험에 뛰어든다.","genres":["판타지","모험","액션","코미디","소년물"],"ipType":["만화","애니","영화","게임"],"officialUrl":"https://fairytail-tv.com/","source":"https://fairytail-tv.com/story/"},
  {"slug":"fate-grand-order","description":"인리보호기관 칼데아의 마지막 마스터가 서번트들과 특이점을 찾아 인류 멸망의 역사를 바로잡는다.","genres":["판타지","액션","모험","드라마"],"ipType":["게임","애니","영화","만화"],"officialUrl":"https://www.fate-go.jp/","source":"https://www.fate-go.jp/world/1st/"},
  {"slug":"pochacco","description":"산책과 샛길로 새는 일을 좋아하고 조금 덤벙대지만 호기심 많고 참견하기 좋아하는 강아지 소년.","genres":["일상","가족","코미디"],"ipType":["캐릭터"],"officialUrl":"https://www.sanrio.co.jp/characters/pochacco/","source":"https://www.sanrio.co.jp/characters/pochacco/"},
  {"slug":"pokemon","description":"신비한 생물 포켓몬을 만나 모으고 키우며 배틀과 교환, 새로운 세계의 모험을 즐기는 프랜차이즈.","genres":["모험","판타지","액션","가족"],"ipType":["게임","카드게임","애니","영화","만화","캐릭터"],"officialUrl":"https://www.pokemon.co.jp/","source":"https://corporate.pokemon.co.jp/en/business/games/"},
  {"slug":"pompompurin","description":"갈색 베레모가 트레이드마크인 느긋한 골든리트리버 소년으로 낮잠과 신발 모으기를 좋아한다.","genres":["일상","가족","코미디"],"ipType":["캐릭터"],"officialUrl":"https://www.sanrio.co.jp/characters/pompompurin/","source":"https://www.sanrio.co.jp/characters/pompompurin/"},
  {"slug":"project-sekai","description":"소년소녀들이 진정한 마음을 비추는 세카이에서 미쿠들과 노래하며 자신의 마음과 꿈을 찾아간다.","genres":["음악","아이돌","드라마","학원"],"ipType":["게임","애니","영화","캐릭터"],"officialUrl":"https://pjsekai.sega.jp/","source":"https://pjsekai.sega.jp/story/index.html"},
  {"slug":"precure","description":"평범한 소녀들이 전설의 전사 프리큐어로 변신해 동료와 힘을 모아 소중한 일상을 지킨다.","genres":["마법소녀","액션","판타지","가족"],"ipType":["애니","영화","만화","게임","캐릭터"],"officialUrl":"https://www.toei-anim.co.jp/tv/precure/","source":"https://www.toei-anim.co.jp/tv/precure/"},
  {"slug":"peanuts","description":"찰리 브라운과 스누피를 비롯한 아이들이 우정과 고민, 작은 행복을 재치 있는 일상 속에 펼친다.","genres":["일상","코미디","가족","드라마"],"ipType":["만화","애니","영화","캐릭터","게임"],"officialUrl":"https://www.peanuts.com/","source":"https://www.peanuts.com/about-peanuts"},
  {"slug":"pikmin","description":"작고 신비한 생물 피크민의 서로 다른 능력을 이끌어 미지의 행성을 탐사하고 위험을 헤쳐 나간다.","genres":["모험","퍼즐","SF","가족"],"ipType":["게임","애니","캐릭터"],"officialUrl":"https://www.nintendo.com/jp/character/pikmin/","source":"https://www.nintendo.com/jp/character/pikmin/"},
  {"slug":"pixar","description":"기술과 창의적인 이야기의 결합으로 장편·단편 컴퓨터 애니메이션을 제작하는 애니메이션 스튜디오.","genres":["기타"],"ipType":["제작사"],"officialUrl":"https://www.pixar.com/","source":"https://www.pixar.com/our-story"},
  {"slug":"howls-moving-castle","description":"마녀의 저주로 노인이 된 소피가 움직이는 성에 들어가 마법사 하울과 전쟁의 소용돌이를 헤쳐 나간다.","genres":["판타지","모험","로맨스","드라마"],"ipType":["소설","영화","애니"],"officialUrl":"https://www.ghibli.jp/works/howl/","source":"https://www.ghibli.jp/works/howl/"}
